# Copy to .env for a local (non-Docker) run. docker compose supplies its own
# values for everything below and needs no .env file.

DJANGO_SECRET_KEY=replace-with-strong-secret
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,webhook_web,host.docker.internal
TIME_ZONE=UTC

POSTGRES_DB=webhooks
POSTGRES_USER=webhooks
POSTGRES_PASSWORD=webhooks
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=120
CELERY_TASK_SOFT_TIME_LIMIT=90

# Backs the vendor-profile lookup and the per-vendor arrival counter. Leave
# empty for an in-process cache, which is what the test suite uses. Set it to
# a Redis URL whenever more than one process is running, so a profile edited
# in one worker is seen by the others.
CACHE_URL=redis://redis:6379/2

# Which normaliser reads the payloads: openai, rules, or auto.
# auto picks openai when OPENAI_API_KEY is set and rules otherwise, so the
# whole pipeline runs with no key and no billable call.
NORMALIZATION_BACKEND=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
NORMALIZATION_PROMPT_VERSION=v1

# The confidence gate. Below this, an event is recorded but withheld from
# entity state until a person approves it.
LOW_CONFIDENCE_THRESHOLD=0.70

# Listing page sizes. The cap stops a caller asking for the whole table.
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# Two normalisation lanes. A vendor whose arrivals cross NOISY_VENDOR_BURST
# inside NOISY_VENDOR_WINDOW_SECONDS is routed to the bulk lane, so its burst
# cannot monopolise the pool every other vendor is waiting on.
NORMALIZATION_QUEUE=normalization
NORMALIZATION_BULK_QUEUE=normalization.bulk
NOISY_VENDOR_BURST=200
NOISY_VENDOR_WINDOW_SECONDS=60

# Per-vendor HMAC-SHA256 signing secrets: vendor=secret,other=secret
# Use * as the vendor to require one shared secret from every sender.
# Empty means no vendor is verified.
WEBHOOK_SIGNING_SECRETS=
# Refuse any vendor that has no configured secret.
WEBHOOK_REQUIRE_SIGNATURE=False

DJANGO_LOG_LEVEL=INFO
DRF_ANON_THROTTLE=1200/min
